# Local development env — copy to .env.local (`npm run dev:up` does this for you on first run).
# Points the app at the LOCAL Docker stack (Postgres + neon-http proxy), NOT prod.

# Turns on the local-proxy redirect in src/db/neonConfig.ts.
NEON_LOCAL=1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_calendar

# Any random string is fine locally.
AUTH_SECRET=local-dev-secret-change-me
